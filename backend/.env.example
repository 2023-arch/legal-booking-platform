# =============================================================================
# LEGAL BOOKING PLATFORM - Environment Configuration
# =============================================================================
# SECURITY WARNING: 
# - Never commit .env files with real credentials
# - Rotate SECRET_KEY regularly in production
# - Use strong, unique passwords for all services
# =============================================================================

PROJECT_NAME="Legal Booking Platform"
API_V1_STR="/api/v1"

# =============================================================================
# DATABASE
# =============================================================================
# Use Neon PostgreSQL for production: postgresql+asyncpg://user:pass@host/db
DATABASE_URL=sqlite+aiosqlite:///./legal_booking.db

# =============================================================================
# CACHE (Redis)
# =============================================================================
# Use Upstash for free cloud Redis: redis://default:password@host:port
# Falls back to in-memory cache if unavailable
REDIS_URL=redis://localhost:6379

# =============================================================================
# SECURITY (CRITICAL - Change in production!)
# =============================================================================
# Generate a secure key with: openssl rand -hex 32
# ROTATE THIS KEY PERIODICALLY!
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_use_openssl_rand_hex_32
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# =============================================================================
# ADMIN PANEL (CRITICAL)
# =============================================================================
# Set strong credentials for admin access
ADMIN_PASSWORD=SecureAdmin@2026!
ADMIN_SECRET_KEY=admin-jwt-secret-key-change-in-production

# =============================================================================
# STORAGE - Cloudinary (Recommended)
# =============================================================================
USE_CLOUDINARY=True
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# =============================================================================
# AI - Google Gemini
# =============================================================================
GEMINI_API_KEY=your_gemini_api_key

# =============================================================================
# PAYMENTS - Razorpay (CRITICAL for bookings)
# =============================================================================
# Get credentials from: https://dashboard.razorpay.com/app/keys
# Use rzp_test_xxx keys for testing, rzp_live_xxx for production
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXX

# =============================================================================
# VIDEO - Agora (for video consultations)
# =============================================================================
# Get from: https://console.agora.io/
AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_certificate

# =============================================================================
# EMAIL - SMTP (for notifications)
# =============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@legalbook.in
SMTP_PASSWORD=your_app_specific_password

# =============================================================================
# AWS S3 (Alternative to Cloudinary)
# =============================================================================
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_S3_BUCKET=legal-booking-bucket
AWS_REGION=ap-south-1

# =============================================================================
# VECTOR DB - Pinecone (Optional - for RAG features)
# =============================================================================
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=

# =============================================================================
# CORS - Allowed Origins
# =============================================================================
# Comma-separated list of allowed origins
BACKEND_CORS_ORIGINS=http://localhost:3000,https://localhost:3000,https://legal-booking-platform.vercel.app

